#!/usr/bin/env bash
#
# Deploys a test instance with a routed NIC, as "task check" does, and waits
# until the ToR reaches it: Bird in the VM announces both its addresses.
# The instance stays until --delete.
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

n=1
vm=""
delete=""

#
# Prints usage information for task routed.
#
function usage()
{
	cat <<USAGE
usage: task routed [-- [OPTIONS] [N]]

Arguments:

	N			Picks the name and the addresses, from 1 to
				253 (default: 1): routedN, 203.0.113.N and
				2001:db8:200::N

Options:

	    --vm		A virtual machine in place of a container
	    --delete		Removes the instance
	-h, --help		Prints this message

Examples:

	$ task routed
	$ task routed -- 2
	$ task routed -- 3 --vm
	$ task routed -- 2 --delete

USAGE
}

#
# Parses command-line options for task routed.
#
function parse_options()
{
	local argv=()

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--vm)
				vm="--vm"
				shift
				;;
			--delete)
				delete=1
				shift
				;;
			-h|--help)
				usage
				exit
				;;
			-*)
				echo "routed: unrecognized option $1" >&2
				return 1
				;;
			*)
				argv+=("$1")
				shift
				;;
		esac
	done

	case ${#argv[*]} in
		0)	;;
		1)	n="${argv[0]}" ;;
		*)
			echo "routed: too many arguments given" >&2
			return 1
			;;
	esac

	case "$n" in
		*[!0-9]*|"")
			echo "routed: $n is not a number" >&2
			return 1
			;;
	esac

	n=$(( 10#$n ))
	if (( n < 1 || n > 253 )); then
		echo "routed: the number must be from 1 to 253" >&2
		return 1
	fi
}

parse_options "$@" || exit $?
instance="routed$n"

check_bgp || exit $?

if [[ -n "$delete" ]]; then
	log "Deleting $instance ..."
	guest incus delete --force "$instance" ||
		fail "Deleting $instance failed!"
	exit
fi

guest incus info "$instance" >/dev/null 2>&1 &&
	fail "$instance exists already! Remove it: task routed -- $n --delete"

launch_routed "$instance" "$n" "$vm" || fail "Launching $instance failed!"
wait_for_routed "$n" "$vm" ||
	fail "The ToR does not reach $instance! See: task tor"

log "$instance answers the ToR on 203.0.113.$n and 2001:db8:200::$n."
log "In it: limactl shell $name incus exec $instance -- sh"
