#!/usr/bin/env bash
#
# Opens the dashboards in the browser: both, or the one that is named.
#
#   bin/dash          the Incus web UI, and the Ceph dashboard with Ceph
#   bin/dash incus    the Incus web UI, logged in
#   bin/dash ceph     the Ceph dashboard
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

case "${1:-}" in
	"")
		if vm_has_ceph; then
			"${0%/*}/dash-ceph" || exit $?
		fi
		"${0%/*}/dash-incus"
		;;
	incus)	"${0%/*}/dash-incus" ;;
	ceph)	"${0%/*}/dash-ceph" ;;
	*)
		echo "usage: task dashboard [-- incus|ceph]" >&2
		exit 1
		;;
esac
