#!/usr/bin/env bash
#
# Deletes the VM and everything in it, the copy saved for "task reset", and
# the incus remote that bin/dash-incus added for it.
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

# Ends the web UI session of bin/dash-incus, if there is one.
pkill -f "incus webui $name:"

if vm_exists; then
	log "Deleting $name ..."
	limactl delete --force "$name" >/dev/null 2>&1 ||
		fail "Deleting $name failed!"
fi

if vm_exists "$base"; then
	limactl delete --force "$base" >/dev/null 2>&1 ||
		fail "Deleting $base failed!"
fi

# Until the ToR moved into the VM, it was a VM of its own.
if vm_exists "$name-tor"; then
	log "Deleting $name-tor, the ToR of an older version ..."
	limactl delete --force "$name-tor" >/dev/null 2>&1 ||
		fail "Deleting $name-tor failed!"
fi

if command -v incus >/dev/null; then
	# Your default remote is only changed when it is the one being removed.
	if [[ "$(incus remote get-default </dev/null)" == "$name" ]]; then
		incus remote switch local </dev/null
	fi
	incus remote remove "$name" >/dev/null 2>&1 </dev/null
fi

log "Deleted $name."
