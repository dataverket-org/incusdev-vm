#!/usr/bin/env bash
#
# Runs the end-to-end test: provision/check.sh inside the VM, then the
# services through the port forwards on this computer. A VM made with Ceph
# is tested with it, and fails the test without it.
#
# With a ToR, it also checks that the two have routes to each other: the
# ToR pings incusbr0's addresses from the fabric's, over IPv4 and IPv6. Then
# it launches an instance with a routed NIC, and the ToR pings its two
# addresses, which only Bird in the VM announces. It removes the instance,
# and force-deletes any instance named incusdev-routed.
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

vm=""
ceph=""

# The instance with a routed NIC: 203.0.113.254 and 2001:db8:200::254, out
# of the way of "task routed".
routed="incusdev-routed"
routed_n=254

#
# Prints usage information for task check.
#
function usage()
{
	cat <<USAGE
usage: task check [-- OPTIONS]

Options:

	    --vm		Launches virtual machines in place of
				containers, which needs nested virtualization
	-h, --help		Prints this message

Examples:

	$ task check
	$ task check -- --vm

USAGE
}

#
# Parses command-line options for task check.
#
function parse_options()
{
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--vm)
				vm="--vm"
				shift
				;;
			-h|--help)
				usage
				exit
				;;
			*)
				echo "check: unrecognized option $1" >&2
				return 1
				;;
		esac
	done
}

#
# Checks that one end of the link carries IPv6 only: it has no IPv4 address
# there, and every IPv4 route that Bird put in that kernel goes by an IPv6
# link-local next hop. The end is the function that runs a command there,
# and its interface.
#
function check_ipv6_end()
{
	local end="$1"
	local iface="$2"
	local routes

	if [[ -n "$($end ip -4 -o address show dev "$iface")" ]]; then
		error "$iface has an IPv4 address!"
		return 1
	fi

	routes="$($end ip -4 route show proto bird)"
	[[ -n "$routes" ]] || return 1
	printf "  %s\n" "${routes//$'\n'/$'\n'  }"
	if echo "$routes" | grep -qv " via inet6 fe80::"; then
		error "An IPv4 route has no IPv6 link-local next hop!"
		return 1
	fi
}

#
# Checks that the link carries IPv6 only, at both its ends.
#
function check_ipv6_link()
{
	log "Checking that the link to the ToR carries IPv4 over IPv6 only ..."
	check_ipv6_end guest "$tor_link"  || return $?
	check_ipv6_end tor_guest server0 || return $?
}

#
# Checks the BGP session and the routes it gives both ends.
#
function check_tor()
{
	local ipv4 ipv6

	log "Waiting for the BGP session to the ToR ..."
	wait_for_bgp || return $?
	check_ipv6_link || return $?

	ipv4="$(guest ip -4 -o address show dev incusbr0 |
		awk '{ sub("/.*", "", $4); print $4; exit }')"
	ipv6="$(guest ip -6 -o address show dev incusbr0 scope global |
		awk '{ sub("/.*", "", $4); print $4; exit }')"

	ping_from_tor 198.51.100.1 "$ipv4" || return $?
	[[ -z "$ipv6" ]] || ping_from_tor 2001:db8:100::1 "$ipv6" || return $?
}

#
# Launches an instance with a routed NIC, and has the ToR ping both its
# addresses. The instance is removed whether the step passes or not.
#
function check_routed()
{
	local status=0

	guest incus delete --force "$routed" >/dev/null 2>&1
	launch_routed "$routed" "$routed_n" "$vm" || return $?
	wait_for_routed "$routed_n" "$vm" || status=$?

	guest incus delete --force "$routed" >/dev/null || return $?
	return "$status"
}

parse_options "$@" || exit $?
check_running      || exit $?
vm_has_ceph && ceph="--ceph"

# The script travels as an argument, since stdin is closed in the VM, and
# its options after it.
# shellcheck disable=SC2086
guest sudo bash -c "$(< "$root/provision/check.sh")" bash $vm $ceph ||
	fail "The test failed inside $name!"

if vm_has_bgp; then
	check_tor    || fail "The ToR and $name have no routes to each other!"
	check_routed || fail "The ToR has no route to a routed NIC!"
	log "The ToR and $name route to each other, and to routed NICs."
fi

print_services | tee /dev/stderr | grep -q " down " &&
	fail "A service does not answer on this computer!"

log "All good on this computer too."
