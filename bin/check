#!/usr/bin/env bash
#
# Runs the end-to-end test: provision/check.sh inside the VM, then the
# services through the port forwards on this computer. With a ToR, the ToR
# pings incusbr0 and a routed NIC, and when the other host runs, this one
# pings the other's incusbr0 through the ToR. It removes what it makes, and
# force-deletes any instance named incusdev-routed.
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

vm=""

# Out of the way of "task routed".
routed="incusdev-routed"
routed_n=254

#
# Prints usage information for task check.
#
function usage()
{
	cat <<USAGE
usage: task check [-- OPTIONS]

Options:

	    --vm		Virtual machines in place of containers, which
				need nested virtualization
	-h, --help		Prints this message

Examples:

	$ task check
	$ task check -- --vm
	$ INCUSDEV_HOST=2 task check	incusdev2, from the local pool

USAGE
}

#
# Parses command-line options for task check.
#
function parse_options()
{
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--vm)
				vm="--vm"
				shift
				;;
			-h|--help)
				usage
				exit
				;;
			*)
				echo "check: unrecognized option $1" >&2
				return 1
				;;
		esac
	done
}

#
# Runs provision/check.sh inside the VM. The script travels as an argument:
# stdin is closed in the VM.
#
function check_inside()
{
	local args=()

	[[ -n "$vm" ]]        && args+=(--vm)
	[[ -n "$with_ceph" ]] || args+=(--no-ceph)
	guest sudo bash -c "$(< "$root/provision/check.sh")" \
		bash "${args[@]}" || return $?
}

#
# Checks that the link carries IPv6 only: lima0 has no IPv4 address at
# either end, and every IPv4 route that Bird put in either kernel goes by an
# IPv6 link-local next hop.
#
function check_ipv6_link()
{
	local end routes

	log "Checking that the link to $tor carries IPv4 over IPv6 only ..."
	for end in guest tor_guest; do
		if [[ -n "$($end ip -4 -o address show dev lima0)" ]]; then
			error "lima0 has an IPv4 address."
			return 1
		fi

		routes="$($end ip -4 route show proto bird)"
		printf "  %s\n" "${routes//$'\n'/$'\n'  }"
		[[ -n "$routes" ]] || return 1
		if echo "$routes" | grep -qv " via inet6 fe80::"; then
			error "An IPv4 route has no IPv6 link-local next hop."
			return 1
		fi
	done
}

#
# Prints the first global address of incusbr0 in a VM, of a family: 4 or 6.
#
function bridge_address()
{
	local vm="$1"
	local family="$2"

	limactl shell --workdir / "$vm" \
		ip "-$family" -o address show dev incusbr0 scope global \
		</dev/null | awk '{ sub("/.*", "", $4); print $4; exit }'
}

#
# Checks the BGP session and the routes it gives both ends.
#
function check_tor()
{
	local ipv4 ipv6

	log "Waiting for the BGP session to $tor ..."
	wait_for_bgp || return $?
	check_ipv6_link || return $?

	ipv4="$(bridge_address "$name" 4)"
	ipv6="$(bridge_address "$name" 6)"

	ping_from_tor 198.51.100.1 "$ipv4" || return $?
	[[ -z "$ipv6" ]] || ping_from_tor 2001:db8:100::1 "$ipv6" || return $?
}

#
# Launches an instance with a routed NIC, and has the ToR ping both its
# addresses. The instance is removed whether the step passes or not.
#
function check_routed()
{
	local status=0

	guest incus delete --force "$routed" >/dev/null 2>&1
	launch_routed "$routed" "$routed_n" "$vm" || return $?
	wait_for_routed "$routed_n" "$vm" || status=$?

	guest incus delete --force "$routed" >/dev/null || return $?
	return "$status"
}

#
# Pings the other host's incusbr0 addresses from this host, when the other
# host runs.
#
function check_other_host()
{
	local other vm ipv4 ipv6

	for vm in $hosts; do
		[[ "$vm" != "$name" ]] && other="$vm"
	done
	vm_runs "$other" || return 0

	ipv4="$(bridge_address "$other" 4)"
	ipv6="$(bridge_address "$other" 6)"

	log "Pinging $other's incusbr0 from $name, through $tor ..."
	guest ping -c 3 -W 2 "$ipv4" || return $?
	[[ -z "$ipv6" ]] || guest ping -c 3 -W 2 "$ipv6" || return $?
}

parse_options "$@" || exit $?
check_running      || exit $?

check_inside || fail "The test failed inside $name!"

if vm_exists "$tor"; then
	check_tor_running || exit $?
	check_tor         || fail "$tor and $name have no routes to each other!"
	check_routed      || fail "$tor has no route to a routed NIC!"
	log "The ToR and $name route to each other, and to routed NICs."
	check_other_host  || fail "$name does not reach the other host!"
fi

print_services | tee /dev/stderr | grep -q " down " &&
	fail "A service does not answer on this computer!"

log "All good on this computer too."
