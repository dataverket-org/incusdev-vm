#!/usr/bin/env bash
#
# Creates the VM on the first run and starts it on later runs. It returns at
# once and the work goes on in the background: "task status" follows it.
#
# Lima runs the scripts in provision/ that lima.yaml lists on every start,
# so the first start is the install, about 6 minutes. It ends with one
# restart: the VM is stopped, and a copy of it is saved for "task reset".
# Arguments go to limactl when the VM is created:
#
#   task up -- --cpus 4 --memory 8 --disk 40
#
# With INCUS_SRC set, a new VM gets that directory mounted, writable and at
# the same path.
#
# With --tor, on macOS, a new VM gets a simulated top-of-rack switch: a
# second VM, incusdev-tor, with Bird2, on a point-to-point link to incusdev,
# which runs Bird2 too. "task p2p" lays the link first. Later starts, and
# "task reset", keep the switch; "task destroy" removes it:
#
#   task up -- --tor
#
# With INCUSDEV_HOST=2 it makes or starts incusdev2 instead: a second Incus
# host, standalone, without Ceph, on the same ToR, which it starts or makes
# first. A new incusdev2 is ready in about 3 minutes:
#
#   INCUSDEV_HOST=2 task up
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

#
# Prints the limactl options for this platform: the Virtualization framework
# on macOS, QEMU with KVM on Linux, nested virtualization on both.
#
function platform_options()
{
	case "$(uname -s)" in
		Darwin)	echo "--vm-type=vz --nested-virt" ;;
		Linux)	echo "--vm-type=qemu" ;;
		*)	return 1 ;;
	esac
}

#
# Prints the yq expression that gives a new VM this host's settings: the
# params that the provision scripts read, and the ports on this computer.
#
function lima_settings()
{
	local ceph="no"

	[[ -n "$with_ceph" ]] && ceph="yes"
	echo ".param.INCUS_SUBNET = \"$bridge_subnet\" |" \
	     ".param.INCUSDEV_CEPH = \"$ceph\" |" \
	     ".param.BGP_ASN = \"$asn\" |" \
	     ".param.BGP_ROUTED4 = \"$routed4.0/24\" |" \
	     ".param.BGP_ROUTED6 = \"$routed6::/48\" |" \
	     ".portForwards[0].hostPort = $incus_port |" \
	     ".portForwards[1].hostPort = $ceph_port |" \
	     ".portForwards[2].hostPort = $s3_port"
}

#
# Creates or starts the ToR's VM and waits for it.
#
function start_tor()
{
	vm_runs "$tor" && return

	if vm_exists "$tor"; then
		log "Starting $tor, the ToR ..."
		limactl start --tty=false --timeout 10m "$tor" || return $?
		return
	fi

	log "Creating $tor, the ToR ..."
	limactl start --tty=false --timeout 10m --name "$tor" --vm-type=vz \
		--network "lima:$p2p_network_tor" "$root/tor.yaml" || return $?
}

#
# Creates or starts the VM and waits for it. A new VM is stopped once after
# the install, and a copy of it is saved for "task reset". With a ToR, the
# ToR starts first, and a new VM gets the link to it. This is what runs in
# the background.
#
# One after the other, not side by side: each limactl start stops the
# socket_vmnet daemons that no VM uses, and a VM being created does not
# count yet.
#
function run()
{
	if [[ -n "$with_tor" ]]; then
		start_tor || return $?
	fi

	vm_runs && return

	if vm_exists; then
		limactl start --tty=false --timeout 20m "$name" || return $?
		return
	fi

	# shellcheck disable=SC2046
	limactl start --tty=false --timeout 20m --name "$name" \
		$(platform_options) ${incus_src:+--mount "$incus_src:w"} \
		${with_tor:+--network "lima:$p2p_network"} \
		--set "$(lima_settings)" "$@" "$root/lima.yaml" || return $?

	log "Saving a copy of $name for 'task reset', and restarting it ..."
	limactl stop "$name" || return $?
	limactl delete --force "$base" >/dev/null 2>&1
	limactl clone --tty=false "$name" "$base" || return $?

	limactl start --tty=false --timeout 20m "$name" || return $?
}

# --run, which runs in the background, and --tor may come anywhere; the rest
# goes to limactl.
in_background=""
with_tor=""
args=()
for arg in "$@"; do
	case "$arg" in
		--run)	in_background=1 ;;
		--tor)	with_tor=1 ;;
		*)	args+=("$arg") ;;
	esac
done

if [[ -n "$in_background" ]]; then
	run "${args[@]}"
	exit $?
fi

command -v limactl >/dev/null || fail "limactl not found. Run: brew bundle"

# incusdev2 reaches incusdev only through the ToR.
if [[ "$name" != "incusdev" ]]; then
	has_tor || fail "$name needs the ToR, and the ToR needs macOS."
	with_tor=1
fi

if [[ -n "$with_tor" ]]; then
	has_tor || fail "The ToR needs macOS: Lima links the two VMs with feth."
	vm_exists && ! vm_exists "$tor" &&
		fail "$name has no ToR. Run 'task destroy' and 'task up -- --tor'!"
fi
vm_exists "$tor" && with_tor=1

if up_runs; then
	log "$name is starting already. Follow it with: task status"
	exit
elif vm_runs && { [[ -z "$with_tor" ]] || vm_runs "$tor"; }; then
	log "$name is running. See its services with: task status"
	exit
elif vm_runs; then
	doing="Starting $tor in the background, about 30 seconds."
elif vm_exists; then
	doing="Starting $name in the background, about 30 seconds."
else
	if [[ "$(uname -s)" == "Linux" && ! -w /dev/kvm ]]; then
		fail "/dev/kvm is missing or not writable!"
	fi

	minutes=6
	[[ -n "$with_ceph" ]] || minutes=3
	doing="Creating $name in the background, about $minutes minutes."
fi

if [[ -n "$with_tor" ]]; then
	check_p2p || exit $?
fi

nohup "$0" --run ${with_tor:+--tor} "${args[@]}" > "$up_log" 2>&1 </dev/null &
echo "$!" > "$up_pid" || fail "Writing $up_pid failed!"

log "$doing"
[[ -n "$with_tor" ]] && ! vm_runs "$tor" && log "$tor, the ToR, starts first."
log "Follow it with: task status"
