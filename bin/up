#!/usr/bin/env bash
#
# Creates the VM on the first run and starts it on later runs. It returns at
# once and the work goes on in the background: "task status" follows it.
#
# Lima runs provision/incus.sh and provision/ceph.sh in the VM on every start,
# so the first start is the install, about 6 minutes. It ends with one
# restart: the VM is stopped, and a copy of it is saved for "task reset".
# Arguments go to limactl when the VM is created:
#
#   task up -- --cpus 4 --memory 8 --disk 40
#
# With INCUS_SRC set, a new VM gets that directory mounted read-only, at the
# same path, for "task dev".
#

source "${0%/*}/functions.sh" || exit $?

#
# Prints the limactl options for this platform: the Virtualization framework
# on macOS, QEMU with KVM on Linux, nested virtualization on both.
#
function platform_options()
{
	case "$(uname -s)" in
		Darwin)	echo "--vm-type=vz --nested-virt" ;;
		Linux)	echo "--vm-type=qemu" ;;
		*)	return 1 ;;
	esac
}

#
# Creates or starts the VM and waits for it. A new VM is stopped once after
# the install, and a copy of it is saved for "task reset". This is what runs
# in the background.
#
function run()
{
	if vm_exists; then
		limactl start --tty=false --timeout 20m "$name" || return $?
		return
	fi

	# shellcheck disable=SC2046
	limactl start --tty=false --timeout 20m --name "$name" \
		$(platform_options) ${incus_src:+--mount "$incus_src"} \
		"$@" "$root/lima.yaml" || return $?

	echo ">>> Saving a copy of $name for 'task reset', and restarting it ..."
	limactl stop "$name" || return $?
	limactl delete --force "$base" >/dev/null 2>&1
	limactl clone --tty=false "$name" "$base" || return $?

	limactl start --tty=false --timeout 20m "$name" || return $?
}

if [[ "${1:-}" == "--run" ]]; then
	shift
	run "$@"
	exit $?
fi

command -v limactl >/dev/null || fail "limactl not found. Run: brew bundle"

if up_runs; then
	log "$name is starting already. Follow it with: task status"
	exit
elif vm_runs; then
	log "$name is running. See its services with: task status"
	exit
elif vm_exists; then
	doing="Starting $name in the background, about 30 seconds."
else
	if [[ "$(uname -s)" == "Linux" && ! -w /dev/kvm ]]; then
		fail "/dev/kvm is missing or not writable!"
	fi

	doing="Creating $name in the background, about 6 minutes."
fi

nohup "$0" --run "$@" > "$up_log" 2>&1 </dev/null &
echo "$!" > "$up_pid" || fail "Writing $up_pid failed!"

log "$doing"
log "Follow it with: task status"
