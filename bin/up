#!/usr/bin/env bash
#
# Creates the VM on the first run and starts it on later runs, in the
# background: "task status" follows it. The first start is the install,
# about 6 minutes, and ends with one restart, after which a copy of the VM
# is saved for "task reset". Lima runs the scripts in provision/ that
# lima.yaml lists on every start.
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

in_background=""
with_ceph=""
with_bgp=""
channel=""
limactl_args=()

#
# Prints usage information for task up.
#
function usage()
{
	cat <<USAGE
usage: task up [-- OPTIONS]

Options:

	    --ceph		A new VM gets a one-node Ceph cluster: the
				storage pool ceph, an S3 API and a dashboard
	    --bgp		A new VM gets a simulated top-of-rack switch,
				and Bird2 peering with it over BGP
	    --stable		A new VM gets Incus from Zabbly's stable
				channel, the newest feature release, in place
				of the LTS
	    --channel NAME	The same, for any channel: lts-7.0, lts-6.0
				or stable
	    --cpus N		CPUs of a new VM (default: 2)
	    --memory GIB	Memory of a new VM (default: 2)
	    --disk GIB		Disk of a new VM (default: 20)
	-h, --help		Prints this message
	--			Hands the rest to limactl, for a new VM

Environment:

	INCUS_SRC=DIR		Mounts DIR into a new VM, writable, at DIR

Examples:

	$ task up
	$ task up -- --ceph
	$ task up -- --ceph --bgp --stable
	$ task up -- --cpus 4 --memory 8 --disk 40

USAGE
}

#
# Parses command-line options for task up. --run is the background half,
# which the foreground one starts.
#
function parse_options()
{
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--ceph)
				with_ceph=1
				shift
				;;
			--bgp)
				with_bgp=1
				shift
				;;
			--stable)
				channel="stable"
				shift
				;;
			--channel)
				if [[ -z "${2:-}" ]]; then
					echo "up: --channel needs a name" >&2
					return 1
				fi
				channel="$2"
				shift 2
				;;
			--cpus|--memory|--disk)
				if [[ -z "${2:-}" ]]; then
					echo "up: $1 needs a value" >&2
					return 1
				fi
				limactl_args+=("$1" "$2")
				shift 2
				;;
			--run)
				in_background=1
				shift
				;;
			-h|--help)
				usage
				exit
				;;
			--)
				shift
				limactl_args+=("$@")
				break
				;;
			*)
				echo "up: unrecognized option $1" >&2
				return 1
				;;
		esac
	done
}

#
# Prints the limactl options for this platform: the Virtualization framework
# on macOS, QEMU with KVM on Linux, nested virtualization on both.
#
function platform_options()
{
	case "$(uname -s)" in
		Darwin)	echo "--vm-type=vz --nested-virt" ;;
		Linux)	echo "--vm-type=qemu" ;;
		*)	return 1 ;;
	esac
}

#
# Prints the yq expression that gives a new VM its settings: the params
# that the scripts in provision/ read, see lima.yaml.
#
function lima_settings()
{
	local ceph="off" bgp="off" settings

	[[ -n "$with_ceph" ]] && ceph="on"
	[[ -n "$with_bgp" ]] && bgp="on"
	settings=".param.CEPH = \"$ceph\" | .param.BGP = \"$bgp\""
	[[ -n "$channel" ]] &&
		settings+=" | .param.INCUS_CHANNEL = \"$channel\""
	echo "$settings"
}

#
# Creates or starts the VM and waits for it. A new VM is stopped once after
# the install, and a copy of it is saved for "task reset". This is what
# runs in the background.
#
function start_vm()
{
	vm_runs && return

	if vm_exists; then
		limactl start --tty=false --timeout 20m "$name" || return $?
		return
	fi

	# shellcheck disable=SC2046
	limactl start --tty=false --timeout 20m --name "$name" \
		$(platform_options) ${incus_src:+--mount "$incus_src:w"} \
		--set "$(lima_settings)" "$@" "$root/lima.yaml" || return $?

	log "Saving a copy of $name for 'task reset', and restarting it ..."
	limactl stop "$name" || return $?
	limactl delete --force "$base" >/dev/null 2>&1
	limactl clone --tty=false "$name" "$base" || return $?

	limactl start --tty=false --timeout 20m "$name" || return $?
}

#
# Checks what this computer needs for the VM. Ceph, BGP and the Incus
# channel are chosen when the VM is made, and hold for its life.
#
function check_requirements()
{
	if ! command -v limactl >/dev/null; then
		error "limactl not found. Run: brew bundle"
		return 1
	fi

	if [[ -n "$with_ceph" ]] && vm_exists && ! vm_has_ceph; then
		error "$name has no Ceph! Run: task destroy, task up -- --ceph"
		return 1
	fi

	if [[ -n "$with_bgp" ]] && vm_exists && ! vm_has_bgp; then
		error "$name has no ToR! Run: task destroy, task up -- --bgp"
		return 1
	fi

	case "$channel" in
		""|stable|lts-[0-9]*.0)	;;
		*)
			error "Unknown Incus channel $channel!"
			error "Use lts-7.0, lts-6.0 or stable."
			return 1
			;;
	esac

	if [[ -n "$channel" ]] && vm_exists; then
		error "$name keeps the Incus it was made with!"
		error "Run: task destroy, task up -- --channel $channel"
		return 1
	fi

	vm_exists && return
	if [[ "$(uname -s)" == "Linux" && ! -w /dev/kvm ]]; then
		error "/dev/kvm is missing or not writable!"
		return 1
	fi
}

parse_options "$@" || exit $?

if [[ -n "$in_background" ]]; then
	start_vm "${limactl_args[@]}"
	exit $?
fi

check_requirements || exit $?

if   up_runs; then
	log "$name is starting already. Follow it with: task status"
	exit
elif vm_runs; then
	log "$name is running. See its services with: task status"
	exit
elif vm_exists; then
	doing="Starting $name in the background, about 30 seconds."
else
	doing="Creating $name in the background, about 6 minutes."
fi

nohup "$0" --run ${with_ceph:+--ceph} ${with_bgp:+--bgp} ${channel:+--channel "$channel"} \
	-- "${limactl_args[@]}" > "$up_log" 2>&1 </dev/null &
echo "$!" > "$up_pid" || fail "Writing $up_pid failed!"

log "$doing"
log "Follow it with: task status"
