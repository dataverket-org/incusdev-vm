#!/usr/bin/env bash
#
# Creates the VM on the first run and starts it on later runs. It returns at
# once and the work goes on in the background: "task status" follows it.
#
# Lima runs the scripts in provision/ that lima.yaml lists on every start,
# so the first start is the install, about 6 minutes. It ends with one
# restart: the VM is stopped, and a copy of it is saved for "task reset".
# Arguments go to limactl when the VM is created:
#
#   task up -- --cpus 4 --memory 8 --disk 40
#
# With INCUS_SRC set, a new VM gets that directory mounted, writable and at
# the same path.
#
# With --tor, on macOS, a new VM gets a simulated top-of-rack switch: a
# second VM, incusdev-tor, with Bird2, on a point-to-point link to incusdev,
# which runs Bird2 too. "task p2p" lays the link first. Later starts, and
# "task reset", keep the switch; "task destroy" removes it:
#
#   task up -- --tor
#

source "${0%/*}/functions.sh" || exit $?

#
# Prints the limactl options for this platform: the Virtualization framework
# on macOS, QEMU with KVM on Linux, nested virtualization on both.
#
function platform_options()
{
	case "$(uname -s)" in
		Darwin)	echo "--vm-type=vz --nested-virt" ;;
		Linux)	echo "--vm-type=qemu" ;;
		*)	return 1 ;;
	esac
}

#
# Creates or starts the ToR's VM and waits for it.
#
function start_tor()
{
	if tor_exists; then
		tor_runs && return
		echo ">>> Starting $tor, the ToR ..."
		limactl start --tty=false --timeout 10m "$tor" || return $?
		return
	fi

	echo ">>> Creating $tor, the ToR ..."
	limactl start --tty=false --timeout 10m --name "$tor" --vm-type=vz \
		--network "lima:$p2p_network_tor" "$root/tor.yaml" || return $?
}

#
# Creates or starts the VM and waits for it. A new VM is stopped once after
# the install, and a copy of it is saved for "task reset". With --tor first,
# the ToR starts before it, and a new VM gets the link to it. This is what
# runs in the background.
#
# One after the other, not side by side: each limactl start stops the
# socket_vmnet daemons that no VM uses, and a VM being created does not
# count yet.
#
function run()
{
	if [[ "${1:-}" == "--tor" ]]; then
		start_tor || return $?
	fi

	run_vm "$@" || return $?
}

#
# Creates or starts incusdev itself, for run. With --tor first, a new VM
# gets the link to the ToR.
#
function run_vm()
{
	local network=""

	if [[ "${1:-}" == "--tor" ]]; then
		shift
		network="lima:$p2p_network"
	fi

	if vm_exists; then
		vm_runs && return
		limactl start --tty=false --timeout 20m "$name" || return $?
		return
	fi

	# shellcheck disable=SC2046
	limactl start --tty=false --timeout 20m --name "$name" \
		$(platform_options) ${incus_src:+--mount "$incus_src:w"} \
		${network:+--network "$network"} "$@" "$root/lima.yaml" || return $?

	echo ">>> Saving a copy of $name for 'task reset', and restarting it ..."
	limactl stop "$name" || return $?
	limactl delete --force "$base" >/dev/null 2>&1
	limactl clone --tty=false "$name" "$base" || return $?

	limactl start --tty=false --timeout 20m "$name" || return $?
}

if [[ "${1:-}" == "--run" ]]; then
	shift
	run "$@"
	exit $?
fi

command -v limactl >/dev/null || fail "limactl not found. Run: brew bundle"

# --tor may come anywhere; the rest goes to limactl.
with_tor=""
args=()
for arg in "$@"; do
	if [[ "$arg" == "--tor" ]]; then
		with_tor="--tor"
	else
		args+=("$arg")
	fi
done

if [[ -n "$with_tor" ]]; then
	has_tor || fail "The ToR needs macOS: Lima links the two VMs with feth."
	if vm_exists && ! tor_exists; then
		fail "$name was made without a ToR. Run 'task destroy' and 'task up -- --tor'!"
	fi
fi
tor_exists && with_tor="--tor"

if up_runs; then
	log "$name is starting already. Follow it with: task status"
	exit
elif vm_runs && { [[ -z "$with_tor" ]] || tor_runs; }; then
	log "$name is running. See its services with: task status"
	exit
elif vm_runs; then
	doing="Starting $tor in the background, about 30 seconds."
elif vm_exists; then
	doing="Starting $name in the background, about 30 seconds."
else
	if [[ "$(uname -s)" == "Linux" && ! -w /dev/kvm ]]; then
		fail "/dev/kvm is missing or not writable!"
	fi

	doing="Creating $name in the background, about 6 minutes."
fi

if [[ -n "$with_tor" ]]; then
	check_p2p || exit $?
fi

nohup "$0" --run ${with_tor:+"$with_tor"} "${args[@]}" > "$up_log" 2>&1 </dev/null &
echo "$!" > "$up_pid" || fail "Writing $up_pid failed!"

log "$doing"
[[ -n "$with_tor" ]] && ! vm_runs && log "$tor, the ToR, starts first."
log "Follow it with: task status"
