#!/usr/bin/env bash
#
# Creates the VM on the first run and starts it on later runs, in the
# background: "task status" follows it. The first start is the install, and
# ends with one restart, after which a copy is saved for "task reset". Lima
# runs the scripts in provision/ that lima.yaml lists on every start.
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

in_background=""
with_tor=""
limactl_args=()

#
# Prints usage information for task up.
#
function usage()
{
	cat <<USAGE
usage: task up [-- OPTIONS]

Options:

	    --tor		A new VM gets the link to the ToR, on macOS,
				which "task p2p" lays first. incusdev2 always
				has it.
	    --cpus N		CPUs of a new VM (default: 2)
	    --memory GIB	Memory of a new VM (default: 2)
	    --disk GIB		Disk of a new VM (default: 20)
	-h, --help		Prints this message
	--			Hands the rest to limactl, for a new VM

Environment:

	INCUSDEV_HOST=2		incusdev2 in place of incusdev
	INCUS_SRC=DIR		Mounts DIR into a new VM, writable, at DIR

Examples:

	$ task up
	$ task up -- --tor --cpus 4 --memory 8 --disk 40
	$ INCUSDEV_HOST=2 task up

USAGE
}

#
# Parses command-line options for task up. --run is the background half,
# started by the foreground one.
#
function parse_options()
{
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--tor)
				with_tor=1
				shift
				;;
			--cpus|--memory|--disk)
				limactl_args+=("$1" "$2")
				shift 2
				;;
			--run)
				in_background=1
				shift
				;;
			-h|--help)
				usage
				exit
				;;
			--)
				shift
				limactl_args+=("$@")
				break
				;;
			*)
				echo "up: unrecognized option $1" >&2
				return 1
				;;
		esac
	done
}

#
# Prints the limactl options for this platform: the Virtualization framework
# on macOS, QEMU with KVM on Linux, nested virtualization on both.
#
function platform_options()
{
	case "$(uname -s)" in
		Darwin)	echo "--vm-type=vz --nested-virt" ;;
		Linux)	echo "--vm-type=qemu" ;;
		*)	return 1 ;;
	esac
}

#
# Prints the yq expression that gives a new VM this host's settings: the
# params that the provision scripts read, and the ports on this computer.
#
function lima_settings()
{
	local ceph="no"

	[[ -n "$with_ceph" ]] && ceph="yes"
	echo ".param.INCUS_SUBNET = \"$bridge_subnet\" |" \
	     ".param.INCUSDEV_CEPH = \"$ceph\" |" \
	     ".param.BGP_ASN = \"$asn\" |" \
	     ".param.BGP_ROUTED4 = \"$routed4.0/24\" |" \
	     ".param.BGP_ROUTED6 = \"$routed6::/48\" |" \
	     ".portForwards[0].hostPort = $incus_port |" \
	     ".portForwards[1].hostPort = $ceph_port |" \
	     ".portForwards[2].hostPort = $s3_port"
}

#
# Creates or starts the ToR's VM and waits for it.
#
function start_tor()
{
	vm_runs "$tor" && return

	if vm_exists "$tor"; then
		log "Starting $tor, the ToR ..."
		limactl start --tty=false --timeout 10m "$tor" || return $?
		return
	fi

	log "Creating $tor, the ToR ..."
	limactl start --tty=false --timeout 10m --name "$tor" --vm-type=vz \
		--network "lima:$p2p_network_tor" "$root/tor.yaml" || return $?
}

#
# Creates or starts the ToR, then the VM, and waits for them. A new VM is
# stopped once after the install, and copied for "task reset".
#
# Not side by side: each limactl start stops the socket_vmnet daemons that
# no VM uses, and a VM being created does not count yet.
#
function start_vms()
{
	if [[ -n "$with_tor" ]]; then
		start_tor || return $?
	fi

	vm_runs && return

	if vm_exists; then
		limactl start --tty=false --timeout 20m "$name" || return $?
		return
	fi

	# shellcheck disable=SC2046
	limactl start --tty=false --timeout 20m --name "$name" \
		$(platform_options) ${incus_src:+--mount "$incus_src:w"} \
		${with_tor:+--network "lima:$p2p_network"} \
		--set "$(lima_settings)" "$@" "$root/lima.yaml" || return $?

	log "Saving a copy of $name for 'task reset', and restarting it ..."
	limactl stop "$name" || return $?
	limactl delete --force "$base" >/dev/null 2>&1
	limactl clone --tty=false "$name" "$base" || return $?

	limactl start --tty=false --timeout 20m "$name" || return $?
}

#
# Checks what this computer needs for the VM, and for the ToR when the VM
# has one. incusdev2 always has it.
#
function check_requirements()
{
	if ! command -v limactl >/dev/null; then
		error "limactl not found. Run: brew bundle"
		return 1
	fi

	[[ "$name" != "incusdev" ]] && with_tor=1
	vm_exists "$tor" && with_tor=1
	[[ -n "$with_tor" ]] || return 0

	if ! has_tor; then
		error "The ToR needs macOS: Lima links the VMs with feth."
		return 1
	fi

	if vm_exists && ! vm_exists "$tor"; then
		error "$name has no ToR! Run: task destroy, task up -- --tor"
		return 1
	fi
}

parse_options "$@" || exit $?

if [[ -n "$in_background" ]]; then
	start_vms "${limactl_args[@]}"
	exit $?
fi

check_requirements || exit $?

if   up_runs; then
	log "$name is starting already. Follow it with: task status"
	exit
elif vm_runs && { [[ -z "$with_tor" ]] || vm_runs "$tor"; }; then
	log "$name is running. See its services with: task status"
	exit
elif vm_runs; then
	doing="Starting $tor in the background, about 30 seconds."
elif vm_exists; then
	doing="Starting $name in the background, about 30 seconds."
elif [[ "$(uname -s)" == "Linux" && ! -w /dev/kvm ]]; then
	fail "/dev/kvm is missing or not writable!"
elif [[ -n "$with_ceph" ]]; then
	doing="Creating $name in the background, about 6 minutes."
else
	doing="Creating $name in the background, about 3 minutes."
fi

if [[ -n "$with_tor" ]]; then
	check_p2p || exit $?
fi

nohup "$0" --run ${with_tor:+--tor} -- "${limactl_args[@]}" \
	> "$up_log" 2>&1 </dev/null &
echo "$!" > "$up_pid" || fail "Writing $up_pid failed!"

log "$doing"
[[ -n "$with_tor" ]] && ! vm_runs "$tor" && log "$tor, the ToR, starts first."
log "Follow it with: task status"
