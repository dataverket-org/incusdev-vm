#!/usr/bin/env bash
#
# Stops the VM, and the ToR if there is one. Their disks, and so Incus and
# Ceph, are kept.
#

source "${0%/*}/../share/incusdev-vm/incusdev-vm.sh" || exit $?

# Ends the web UI session of bin/dash-incus, if there is one.
pkill -f "incus webui $name:"

if up_runs; then
	fail "$name is still starting. Follow it with: task status"
fi

if vm_runs; then
	log "Stopping $name ..."
	limactl stop "$name" >/dev/null 2>&1 || fail "Stopping $name failed!"
fi

if vm_runs "$tor"; then
	log "Stopping $tor ..."
	limactl stop "$tor" >/dev/null 2>&1 || fail "Stopping $tor failed!"
fi
