#!/usr/bin/env bash
#
# Stops the VM. Its disk, and so Incus and Ceph, are kept.
#

source "${0%/*}/functions.sh" || exit $?

# Ends the web UI session of bin/dash-incus, if there is one.
pkill -f "incus webui $name:"

if up_runs; then
	fail "$name is still starting. Follow it with: task status"
fi

vm_runs || exit 0

log "Stopping $name ..."
limactl stop "$name" >/dev/null 2>&1 || fail "Stopping $name failed!"
