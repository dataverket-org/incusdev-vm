#!/usr/bin/env bash
#
# Builds Incus from source in the VM and runs it in place of the packaged one:
# provision/incus-dev.sh inside the VM. Run it again after each change.
#
# With INCUS_SRC set on this computer, it builds that tree, which "task up"
# mounts into the VM, read-only, when it creates it. Without it, a clone of
# the main branch inside the VM. "task reset" goes back to the package.
#

source "${0%/*}/functions.sh" || exit $?

#
# Checks that the source tree, when there is one, is mounted in the VM.
#
function check_mount()
{
	[[ -z "$incus_src" ]] && return
	guest test -f "$incus_src/go.mod" || return $?
}

check_running || exit $?
check_mount   || fail "$incus_src is not mounted in $name: see README.md!"

# The script travels as an argument, since stdin is closed in the VM.
guest sudo INCUS_SRC="$incus_src" \
	bash -c "$(< "$root/provision/incus-dev.sh")" ||
	fail "Building Incus in $name failed!"
