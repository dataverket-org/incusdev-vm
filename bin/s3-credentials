#!/usr/bin/env bash
#
# Prints the S3 endpoint and the keys of a user of the object gateway, as
# environment variables for the AWS CLI and other S3 clients:
#
#   eval "$(bin/s3-credentials)"          the S3 user, incusdev
#   eval "$(bin/s3-credentials admin)"    the RadosGW admin user,
#                                         incusdev-admin
#

source "${0%/*}/functions.sh" || exit $?

case "${1:-}" in
	"")	user="incusdev" ;;
	admin)	user="incusdev-admin" ;;
	*)
		echo "s3-credentials: unknown argument: $1" >&2
		exit 1
		;;
esac

check_running || exit $?

# shellcheck disable=SC2016
guest sudo bash -c 'radosgw-admin user info --uid "$1" 2>/dev/null |
	jq -e -r ".keys[0] |
		\"export AWS_ACCESS_KEY_ID=\(.access_key)\",
		\"export AWS_SECRET_ACCESS_KEY=\(.secret_key)\""' bash "$user" ||
	fail "No user $user in $name: the install did not finish!"

echo "export AWS_ENDPOINT_URL=http://127.0.0.1:8000"
echo "export AWS_DEFAULT_REGION=us-east-1"
