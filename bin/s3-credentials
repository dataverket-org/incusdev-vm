#!/usr/bin/env bash
#
# Prints the S3 endpoint and the keys of the incusdev user, as environment
# variables for the AWS CLI and other S3 clients:
#
#   eval "$(bin/s3-credentials)"
#

source "${0%/*}/functions.sh" || exit $?

check_running || exit $?

guest sudo bash -c 'radosgw-admin user info --uid incusdev 2>/dev/null |
	jq -e -r ".keys[0] |
		\"export AWS_ACCESS_KEY_ID=\(.access_key)\",
		\"export AWS_SECRET_ACCESS_KEY=\(.secret_key)\""' ||
	fail "No S3 user in $name: the install did not finish!"

echo "export AWS_ENDPOINT_URL=http://127.0.0.1:8000"
echo "export AWS_DEFAULT_REGION=us-east-1"
